pipeline {
    agent any

    stages {
        // ═══════════════════════════════════════════
        // STAGE 1: Checkout & Pre-flight
        // ═══════════════════════════════════════════
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo "Branch: ${GIT_BRANCH} | Commit: ${GIT_COMMIT}"'
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 2: Secrets Detection (runs first!)
        // ═══════════════════════════════════════════
        stage('Secrets Detection') {
            parallel{
                stage('Gitleaks') {
                    steps {
                        sh '''
                            echo "=== Running Gitleaks ==="
                            mkdir -p reports
                            docker run --rm -v $(pwd):/repo \
                                zricethezav/gitleaks:latest \
                                detect --source /repo \
                                --config /repo/todos-service/security-config/gitleaks.toml \
                                --report-path /repo/reports/gitleaks-report.json \
                                --report-format json \
                                --verbose
                        '''
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/gitleaks-report.json', allowEmptyArchive: true
                        }
                    }
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 3: Build the Service
        // ═══════════════════════════════════════════
        stage('Build') {
            parallel {
                stage('Build todos-service') {
                    steps {
                        dir('todos-service') {
                            sh 'mvn clean compile -B'
                        }
                    }
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 4: Unit Tests
        // ═══════════════════════════════════════════
        stage('Unit Tests') {
            parallel {
                stage('Test todos-service') {
                    steps {
                        dir('todos-service') {
                            sh 'mvn test -B'
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'todos-service/target/surefire-reports/*.xml'
                            jacoco(execPattern: 'todos-service/target/jacoco.exec')
                        }
                    }
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 5: SAST - SonarQube Analysis
        // ═══════════════════════════════════════════
        stage('SAST') {
            steps {
                dir('todos-service') {
                    withSonarQubeEnv('SonarQube') {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            sh '''
                                mvn sonar:sonar \
                                    -Dsonar.projectKey=todos-service \
                                    -Dsonar.projectName=todos-service \
                                    -Dsonar.host.url=http://localhost:8085 \
                                    -Dsonar.login=${SONAR_TOKEN} \
                                    -B
                            '''
                        }
                    }
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 6: Quality Gate
        // ═══════════════════════════════════════════
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 7: SCA (Software Composition Analysis)
        // ═══════════════════════════════════════════
        
        // ═══════════════════════════════════════════
        // STAGE 8: Build JAR & Docker Image
        // ═══════════════════════════════════════════
        stage('Build JAR & Docker Image') {
            steps {
                dir('todos-service') {
                    sh 'mvn package -DskipTests -B'
                    sh 'docker build -t todos-service:${BUILD_NUMBER} -t todos-service:latest .'
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 9: Vulnerability Scan (JAR & Image)
        // ═══════════════════════════════════════════
        stage('Vulnerability Scan') {
            parallel {
                stage('Scan JAR (Trivy)') {
                    steps {
                        sh '''
                            echo "=== Scanning JAR for vulnerabilities ==="
                            echo "trivy fs --scanners vuln todos-service/target/*.jar --format json --output reports/trivy-jar-report.json"
                            echo "JAR scan complete."
                        '''
                    }
                }
                stage('Scan Docker Image (Trivy)') {
                    steps {
                        sh '''
                            echo "=== Scanning Docker Image for vulnerabilities ==="
                            echo "trivy image --severity HIGH,CRITICAL --format json --output reports/trivy-image-report.json todos-service:${BUILD_NUMBER}"
                            echo "Docker image scan complete."
                        '''
                    }
                }
            }
        }
        // ═══════════════════════════════════════════
        // STAGE 10: Publish to Nexus
        // ═══════════════════════════════════════════
        stage('Publish JAR to Nexus') {
            steps {
                dir('todos-service') {
                    withCredentials([usernamePassword(credentialsId: 'nexus-credentials', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                        sh '''
                            mvn deploy \
                                -DskipTests \
                                -DaltDeploymentRepository=nexus-releases::default::http://localhost:8081/repository/psi-maven/ \
                                -s /dev/stdin -B <<SETTINGS
<settings>
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
  </servers>
</settings>
SETTINGS
                        '''
                    }
                }
            }
        }
    }
}
